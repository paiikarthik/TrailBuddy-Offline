# TrailBuddy Offline - Environment Variables Example
# Copy this file to .env and adjust variables as desired.

# Server configuration
PORT=5000
FLASK_DEBUG=0
FLASK_ENV=production

# AI Provider Selection: 'ollama', 'hosted', or 'disabled'
# - 'ollama': Connects to a locally running Ollama instance (default for local dev)
# - 'hosted': Connects to an external OpenAI-compatible open-weight endpoint (vLLM, TGI, etc.)
# - 'disabled': Runs 100% in deterministic rule-based offline mode
AI_PROVIDER=ollama

# Ollama Settings (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Hosted Open-Weight Settings (when AI_PROVIDER=hosted)
HOSTED_AI_ENDPOINT=https://api.together.xyz/v1/chat/completions
HOSTED_AI_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HOSTED_AI_KEY=your_optional_api_key_here

# Timeout & Rate Limiting
AI_TIMEOUT_SECONDS=8.0
RATE_LIMIT_PER_MINUTE=60 per minute
